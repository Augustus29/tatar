{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tatar",
        "width": 1040,
        "height": 700,
        "minWidth": 780,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["en-US", "tr-TR"]
      }
    }
  }
}
